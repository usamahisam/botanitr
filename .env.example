# ===== Server =====
PORT=3000
HOST=127.0.0.1

# ===== Keamanan =====
# Kunci enkripsi AES-256-GCM untuk API keys exchange.
# PENTING: ganti dengan string acak min 32 karakter sebelum produksi.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=change_me_32_chars_random_string_

# ===== Telegram =====
# Token dari @BotFather. Opsional: jika kosong, fitur Telegram dimatikan.
TELEGRAM_BOT_TOKEN=
# ID chat yang diizinkan (pisahkan koma untuk beberapa). Dapatkan via @userinfobot.
TELEGRAM_ALLOWED_CHAT_IDS=

# ===== Proxy =====
# Proxy default untuk koneksi keluar (bisa dioverride per exchange/Telegram di UI).
# Format: http://user:pass@host:port atau socks5://host:port
DEFAULT_PROXY=

# ===== Mode =====
# true = semua bot baru default ke paper trading (rekomendasi)
DEFAULT_PAPER_MODE=true
