{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && cp src/db/schema.sql dist/db/schema.sql",
    "start": "node dist/index.js",
    "test:exchanges": "tsx scripts/test-exchanges.ts",
    "test:live-mock": "tsx scripts/test-live-mock.ts",
    "test:live-e2e": "tsx scripts/test-live-e2e.ts",
    "test:killswitch": "tsx scripts/test-killswitch.ts",
    "test:safety": "tsx scripts/test-safety.ts",
    "test:features": "tsx scripts/test-features-v11.ts",
    "test:v2": "tsx scripts/test-v2.ts",
    "test:auth": "tsx scripts/test-auth-http.ts",
    "test:telegram": "tsx scripts/test-telegram.ts",
    "test:balance": "tsx scripts/test-balance-guard.ts",
    "test:budget": "tsx scripts/test-bot-budget.ts",
    "test:backtest": "tsx scripts/test-backtest-fallback.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "better-sqlite3": "^11.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "https-proxy-agent": "^7.0.5",
    "socks-proxy-agent": "^8.0.4",
    "socket.io": "^4.8.1",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
